<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GitHub Trending Weekly - Week {{ week_number }}</title>
<style>
  :root {
    --bg: #0d1117;
    --card: #161b22;
    --border: #30363d;
    --text: #e6edf3;
    --muted: #8b949e;
    --accent: #58a6ff;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    padding: 20px;
  }
  .container { max-width: 960px; margin: 0 auto; }
  h1 { font-size: 1.8rem; margin-bottom: 8px; }
  .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 24px; }
  h2 {
    font-size: 1.3rem;
    margin: 28px 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    text-transform: capitalize;
  }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  th {
    text-align: left;
    padding: 8px 10px;
    font-size: 0.8rem;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  td {
    padding: 10px;
    border-bottom: 1px solid rgba(48, 54, 61, 0.3);
    font-size: 0.9rem;
  }
  tr:hover td { background: rgba(88, 166, 255, 0.04); }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .stars { font-weight: 600; color: #d29922; }
  .today-stars { color: #3fb950; font-size: 0.85rem; }
  .desc { color: var(--muted); font-size: 0.85rem; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .footer {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }
  .tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(88, 166, 255, 0.1);
    border: 1px solid rgba(88, 166, 255, 0.2);
    font-size: 0.78rem;
    color: var(--accent);
  }
</style>
</head>
<body>
<div class="container">
  <h1>GitHub Trending Weekly</h1>
  <p class="meta">
    <strong>Week {{ week_number }}</strong> &middot;
    {{ date_range }} &middot;
    {{ total_repos }} repos across {{ lang_count }} languages
  </p>

  {% for lang, repos in languages.items() %}
  <h2>{{ lang | capitalize }}</h2>
  {% if repos %}
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Project</th>
        <th>Description</th>
        <th>Stars</th>
        <th>+ Today</th>
      </tr>
    </thead>
    <tbody>
    {% for repo in repos %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><a href="{{ repo.url }}" target="_blank">{{ repo.name }}</a></td>
        <td class="desc">{{ repo.description[:80] if repo.description else '-' }}</td>
        <td class="stars">{{ repo.stars }}</td>
        <td class="today-stars">+{{ repo.today_stars }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p style="color: var(--muted);">No trending data this week.</p>
  {% endif %}
  {% endfor %}

  <div class="footer">
    <p>Data from <a href="https://github.com/trending" target="_blank">GitHub Trending</a></p>
    <p>Generated by <a href="https://github.com/foweh/trending-weekly" target="_blank">trending-weekly</a></p>
  </div>
</div>
</body>
</html>
